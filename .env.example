# انسخ هذا الملف إلى .env وعبّئ القيم. لا ترفع .env إلى GitHub أبدًا.

# ---- النموذج اللغوي ----
LLM_PROVIDER=anthropic           # anthropic | openai
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# لاستخدام OpenAI أو خدمة متوافقة (Groq / OpenRouter / Ollama محلي):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=

# ---- الاسترجاع ----
EMBEDDING_BACKEND=local          # local | openai
EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHUNK_SIZE=700
CHUNK_OVERLAP=150
TOP_K=5
HYBRID_ALPHA=0.5                 # 1 = دلالي فقط، 0 = BM25 فقط
RERANK=false
MIN_SIMILARITY=0                 # عايِرها بعد scripts/evaluate.py
REWRITE_QUERIES=true
PDF_RTL_FIX=auto                 # auto | on | off

# ---- التكلفة (دولار لكل مليون token، من صفحة أسعار المزوّد) ----
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0

# ---- الأمان ----
ADMIN_TOKEN=change-me            # مطلوب للوحة الإدارة ورفع المستندات
LOG_QUESTIONS=true               # حفظ الأسئلة (دون هوية الطالب) للوحة الإحصاءات
